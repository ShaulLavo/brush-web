{
  "name": "brush-web",
  "version": "0.0.14",
  "private": true,
  "type": "module",
  "scripts": {
    "sources": "node scripts/sources.mjs",
    "build:wasm": "node scripts/build-wasm.mjs",
    "dev": "vite --host 0.0.0.0",
    "build": "npm run sources && npm run build:wasm && npm run build:programs && npm run build:bashkit && node scripts/notices.mjs && vite build && node scripts/finish-build.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt --write src scripts tests vite.config.ts playwright.config.ts tsconfig.json package.json",
    "format:check": "oxfmt --check src scripts tests vite.config.ts playwright.config.ts tsconfig.json package.json",
    "test": "playwright test",
    "verify": "npm run build && npm run typecheck && npm run format:check && npm run test:host && npm run test:process && npm run test:bashkit && npm test",
    "measure": "node scripts/measure.mjs",
    "test:rust": "node scripts/check-shell-parser.mjs && cargo test --locked --manifest-path shell/Cargo.toml --workspace && cargo test --locked --manifest-path vendor/brush/Cargo.toml -p brush-interactive --features vt --lib vt:: && cargo test --locked --manifest-path vendor/brush/Cargo.toml -p brush-builtins --lib && cargo test --locked --manifest-path rust/brush-browser/Cargo.toml",
    "serve": "node dist/serve.mjs",
    "compare": "node scripts/compare-commands.mjs",
    "test:host": "node scripts/test-host.mjs",
    "proof": "node scripts/prove-performance.mjs",
    "proof:analyze": "node scripts/analyze-performance.mjs",
    "measure:costs": "node scripts/attribute-costs.mjs",
    "costs:analyze": "node scripts/analyze-costs.mjs",
    "measure:cold": "node scripts/measure-cold-start.mjs",
    "cold:analyze": "node scripts/analyze-cold-start.mjs",
    "bashkit:probe": "node scripts/probe-bashkit.mjs",
    "build:bashkit": "node scripts/build-bashkit.mjs",
    "test:bashkit": "node --test .sources/bashkit/__test__/terminal.test.mjs .sources/bashkit/__test__/bashkit-wasm.test.mjs",
    "compat": "node scripts/bash-compat.mjs",
    "build:programs": "node scripts/build-programs.mjs",
    "measure:external": "node scripts/measure-external.mjs",
    "test:process": "node scripts/test-process-host.mjs",
    "build:shell": "CARGO_TARGET_DIR=.build/shell cargo build --locked --release --target wasm32-wasip1 --manifest-path shell/Cargo.toml --workspace",
    "test:shell:wasi": "node scripts/test-shell-wasi.mjs",
    "test:shell:scoreboard": "node --test scripts/test-shell-scoreboard*.mjs scripts/test-compat-selection.mjs scripts/test-own-shell-runner.mjs",
    "compat:shell": "BASH_COMPAT_MODE=frozen BASH_COMPAT_ENGINES=own-shell node scripts/bash-compat.mjs"
  },
  "dependencies": {
    "@bjorn3/browser_wasi_shim": "0.4.2",
    "@everruns/bashkit-wasm": "0.18.2",
    "@fregat/hotkeys": "https://github.com/ShaulLavo/fregat/releases/download/hotkeys-0.0.2-68d8aaf6f631-260650623e7e/fregat-hotkeys-0.0.2-68d8aaf6f631-260650623e7e.tgz",
    "comlink": "4.4.2",
    "just-bash": "3.6.0",
    "remix": "3.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.3",
    "@webgpu/types": "0.1.74",
    "esbuild": "0.27.7",
    "oxfmt": "0.70.0",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "yaml": "2.9.1"
  }
}
