--- /dev/null
+++ b/brush-core/src/sys/browser.rs
@@ -0,0 +1,67 @@
+//! Cooperative execution controls for a single browser-hosted shell.
+
+#[cfg(all(target_os = "wasi", feature = "browser-host"))]
+#[link(wasm_import_module = "browser")]
+unsafe extern "C" {
+    fn cancelled() -> u32;
+    fn clear_cancel();
+    fn event(kind: u32, value: u32);
+}
+
+/// Stops the current execution when the host has requested an interrupt.
+pub fn check_cancelled() -> Result<(), crate::Error> {
+    #[cfg(all(target_os = "wasi", feature = "browser-host"))]
+    if unsafe { cancelled() } != 0 {
+        return Err(crate::ErrorKind::Interrupted.into());
+    }
+    Ok(())
+}
+
+/// Starts a new prompt after the preceding execution has fully unwound.
+pub fn begin_prompt() {
+    #[cfg(all(target_os = "wasi", feature = "browser-host"))]
+    unsafe {
+        clear_cancel();
+        event(1, 0);
+    }
+}
+
+/// Marks a user command as executing, without clearing pending cancellation.
+pub fn begin_command() {
+    #[cfg(all(target_os = "wasi", feature = "browser-host"))]
+    unsafe {
+        event(2, 0);
+    }
+}
+
+/// Whether commands run serially, allowing regular-file read-ahead to restore shared offsets.
+pub const fn permits_file_read_ahead() -> bool {
+    cfg!(all(target_os = "wasi", feature = "browser-host"))
+}
+
+/// Rejects jobs that need concurrent execution while a synchronous reader blocks.
+pub fn check_background_support() -> Result<(), crate::Error> {
+    #[cfg(all(target_os = "wasi", feature = "browser-host"))]
+    return Err(crate::ErrorKind::NotSupportedOnThisPlatform(
+        "background jobs, coprocesses and process substitution in this browser runtime",
+    )
+    .into());
+    #[cfg(not(all(target_os = "wasi", feature = "browser-host")))]
+    Ok(())
+}
+
+/// Rejects read options whose terminal modes or polling the browser host cannot supply.
+pub fn check_read_support(
+    is_terminal: bool,
+    requests_terminal_modes: bool,
+    requests_timeout: bool,
+) -> Result<(), crate::Error> {
+    #[cfg(all(target_os = "wasi", feature = "browser-host"))]
+    if requests_timeout || (is_terminal && requests_terminal_modes) {
+        return Err(crate::ErrorKind::NotSupportedOnThisPlatform(
+            "read -t or terminal read -n/-N/-s/-d in this browser runtime; plain read and read -r/-p are supported",
+        ).into());
+    }
+    let _ = (is_terminal, requests_terminal_modes, requests_timeout);
+    Ok(())
+}
