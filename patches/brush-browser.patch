+    #[tokio::test]
+    async fn limited_mapfile_then_read_share_file_position() -> Result<(), brush_core::Error> {
+        let fixture = Fixture::new(b"first\nsecond\nthird\n")?;
+        let input = Arc::new(fixture.open()?);
+        let mut shell: brush_core::Shell = brush_core::Shell::builder()
+            .profile(brush_core::ProfileLoadBehavior::Skip)
+            .rc(brush_core::RcLoadBehavior::Skip)
+            .builtins(crate::default_builtins(crate::BuiltinSet::BashMode))
+            .fds(std::collections::HashMap::from([(
+                0,
+                brush_core::openfiles::OpenFile::File(input.clone()),
+            )]))
+            .build()
+            .await?;
+        let params = shell.default_exec_params();
+        let result = shell
+            .run_string(
+                "mapfile -n 1 -t rows; read -r next; [[ ${rows[0]} == first && $next == second ]]",
+                &brush_core::SourceInfo::from("test"),
