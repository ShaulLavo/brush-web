+#[cfg(test)]
+mod tests {
+    use std::cell::Cell;
+    use std::io::Cursor;
+    use std::rc::Rc;
+    use std::sync::Arc;
+    use std::sync::atomic::{AtomicUsize, Ordering};
+
+    use super::*;
+
+    fn command(args: &[&str]) -> MapFileCommand {
+        MapFileCommand::try_parse_from(args).unwrap()
+    }
+
+    fn lines(entries: variables::ArrayLiteral) -> Vec<String> {
+        entries.0.into_iter().map(|(_, line)| line).collect()
+    }
+
+    struct CountedInput {
+        cursor: Cursor<Vec<u8>>,
+        reads: Rc<Cell<usize>>,
+    }
+
+    impl Read for CountedInput {
+        fn read(&mut self, bytes: &mut [u8]) -> std::io::Result<usize> {
+            self.reads.set(self.reads.get() + 1);
+            self.cursor.read(bytes)
+        }
+    }
+
+    impl Seek for CountedInput {
+        fn seek(&mut self, position: SeekFrom) -> std::io::Result<u64> {
+            self.cursor.seek(position)
+        }
+    }
+
+    #[test]
+    fn unlimited_file_reads_use_chunks_and_preserve_unicode_lines() {
+        let text = "界😀é\n".repeat(5000) + "final";
+        let reads = Rc::new(Cell::new(0));
+        let mut input = CountedInput {
+            cursor: Cursor::new(text.as_bytes().to_vec()),
+            reads: reads.clone(),
+        };
+        let entries = lines(
+            command(&["mapfile", "-t"])
+                .read_buffered_file(&mut input)
+                .unwrap(),
+        );
+        assert_eq!(entries.len(), 5001);
+        assert!(entries[..5000].iter().all(|line| line == "界😀é"));
+        assert_eq!(entries.last().unwrap(), "final");
+        assert!(reads.get() <= text.len().div_ceil(8192) + 2);
+        assert_eq!(input.cursor.position(), text.len() as u64);
+    }
+
+    #[test]
+    fn buffered_file_control_bytes_restore_the_shared_position() {
+        for contents in [
+            b"one\n\x03remaining\n".as_slice(),
+            b"one\n\x04remaining\n",
+            b"a\x03b\nremaining\n",
+        ] {
+            let options = command(&["mapfile", "-t"]);
+            let mut original = Cursor::new(contents);
+            let expected = lines(options.read_entries_from(&mut original).unwrap());
+            let mut buffered = Cursor::new(contents);
+            let observed = lines(options.read_buffered_file(&mut buffered).unwrap());
+            assert_eq!(observed, expected);
+            assert_eq!(buffered.position(), original.position());
+            let mut tail = vec![];
+            buffered.read_to_end(&mut tail).unwrap();
+            assert_eq!(
+                tail,
+                &contents[usize::try_from(original.position()).unwrap()..]
+            );
+        }
+    }
+
+    #[test]
+    fn buffered_file_preserves_custom_delimiters_and_skipped_lines() {
+        let mut input = Cursor::new(b"skip\0first\0second\0tail");
+        let entries = command(&["mapfile", "-d", "", "-t", "-s", "1"])
+            .read_buffered_file(&mut input)
+            .unwrap();
+        assert_eq!(lines(entries), ["first", "second", "tail"]);
+        let mut input = Cursor::new(b"first|second|tail");
+        let entries = command(&["mapfile", "-d", "|"])
+            .read_buffered_file(&mut input)
+            .unwrap();
+        assert_eq!(lines(entries), ["first|", "second|", "tail"]);
+    }
+
+    struct InterruptedInput {
+        cursor: Cursor<Vec<u8>>,
+        reads: usize,
+    }
+
+    impl Read for InterruptedInput {
+        fn read(&mut self, bytes: &mut [u8]) -> std::io::Result<usize> {
+            self.reads += 1;
+            if self.reads == 2 {
+                return Err(std::io::ErrorKind::Interrupted.into());
+            }
+            self.cursor.read(bytes)
+        }
+    }
+
+    impl Seek for InterruptedInput {
+        fn seek(&mut self, position: SeekFrom) -> std::io::Result<u64> {
+            self.cursor.seek(position)
+        }
+    }
+
+    #[test]
+    fn buffered_file_propagates_interrupt_between_chunks() {
+        let mut input = InterruptedInput {
+            cursor: Cursor::new(b"x\n".repeat(10000)),
+            reads: 0,
+        };
+        let result = command(&["mapfile", "-t"]).read_buffered_file(&mut input);
+        assert_eq!(
+            result.unwrap_err().as_io_error().unwrap().kind(),
+            std::io::ErrorKind::Interrupted
+        );
+        assert_eq!(input.cursor.position(), 8192);
+        assert_eq!(input.reads, 2);
+    }
+
+    struct Fixture {
+        directory: std::path::PathBuf,
+        remove_parent: bool,
+    }
+
+    impl Fixture {
+        fn new(contents: &[u8]) -> std::io::Result<Self> {
+            static NEXT: AtomicUsize = AtomicUsize::new(0);
+            let parent = std::path::Path::new(env!("CARGO_MANIFEST_DIR")).join("target");
+            let remove_parent = !parent.exists();
+            std::fs::create_dir_all(&parent)?;
+            let directory = parent.join(format!(
+                "mapfile-fixture-{}-{}",
+                std::process::id(),
+                NEXT.fetch_add(1, Ordering::Relaxed)
+            ));
+            std::fs::create_dir(&directory)?;
+            let fixture = Self {
+                directory,
+                remove_parent,
+            };
+            std::fs::write(fixture.directory.join("input"), contents)?;
